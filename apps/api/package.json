    "@carrental/notifications": "workspace:*",
    "@carrental/payments": "workspace:*",
    "@carrental/payouts": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "class-transformer": "0.5.1",
