{
  "name": "@carrental/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "dev": "expo start",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings=0",
    "start": "expo start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@react-navigation/bottom-tabs": "7.18.16",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.8",
    "@tanstack/react-query": "5.101.4",
    "dotenv": "17.2.4",
    "expo": "55.0.29",
    "expo-document-picker": "~55.0.16",
    "expo-image-picker": "~55.0.23",
    "expo-secure-store": "55.0.17",
    "expo-status-bar": "55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.85.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@carrental/test-config": "workspace:*",
    "@carrental/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  }
