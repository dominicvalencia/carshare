model User {
  id                     String     @id @default(uuid()) @db.Uuid
  email                  String?    @db.VarChar(320)
  normalizedEmail        String?    @unique @map("normalized_email") @db.VarChar(320)
  emailVerifiedAt        DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  mobileNumber           String?    @map("mobile_number") @db.VarChar(32)
  normalizedMobileNumber String?    @unique @map("normalized_mobile_number") @db.VarChar(32)
  mobileVerifiedAt       DateTime?  @map("mobile_verified_at") @db.Timestamptz(3)
  passwordHash           String?    @map("password_hash")
  status                 UserStatus @default(ACTIVE)
  failedLoginAttempts    Int        @default(0) @map("failed_login_attempts")
  loginLockedUntil       DateTime?  @map("login_locked_until") @db.Timestamptz(3)
  lastLoginAt            DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile                               UserProfile?
  roles                                 UserRole[]
  sessions                              Session[]
  authTokens                            AuthToken[]
  otpChallenges                         OtpChallenge[]
  ownerProfile                          OwnerProfile?
  verifications                         Verification[]                             @relation("VerificationSubject")
  reviewedVerifications                 Verification[]                             @relation("VerificationReviewer")
  addressAssessments                    Verification[]                             @relation("VerificationAddressAssessor")
  uploadedFiles                         FileAsset[]
  securityEvents                        SecurityEvent[]
  auditLogs                             AuditLog[]                                 @relation("AuditActor")
  ownedVehicles                         Vehicle[]                                  @relation("VehicleOwnerUser")
  vehiclePolicyVersions                 VehiclePolicyVersion[]                     @relation("VehiclePolicyCreator")
  vehicleBlocksCreated                  VehicleBlockedPeriod[]                     @relation("VehicleBlockCreator")
  vehicleStatusChanges                  VehicleStatusHistory[]                     @relation("VehicleStatusActor")
  vehicleDocumentsReviewed              VehicleDocument[]                          @relation("VehicleDocumentReviewer")
  favorites                             UserFavorite[]
  recentSearches                        RenterRecentSearch[]
  recentVehicleViews                    RenterRecentVehicleView[]
  pricingQuotes                         PricingQuote[]                             @relation("QuoteRenter")
  analyticsEvents                       AnalyticsEvent[]
  renterBookings                        Booking[]                                  @relation("BookingRenter")
  ownerBookings                         Booking[]                                  @relation("BookingOwner")
  bookingStatusActions                  BookingStatusHistory[]                     @relation("BookingStatusActor")
  bookingCancellations                  BookingCancellation[]                      @relation("BookingCancellationActor")
  bookingOwnerDecisions                 BookingOwnerDecision[]                     @relation("BookingOwnerDecisionActor")
  bookingIdempotency                    BookingIdempotencyRecord[]
  commissionRulesCreated                CommissionRule[]                           @relation("CommissionRuleCreator")
  inspectionsSubmitted                  Inspection[]                               @relation("InspectionSubmitter")
  inspectionMediaSubmitted              InspectionMedia[]                          @relation("InspectionMediaSubmitter")
  inspectionConfirmations               InspectionConfirmation[]
  pickupChallengesIssued                InspectionVerificationChallenge[]          @relation("PickupChallengeIssuer")
  pickupChallengesConsumed              InspectionVerificationChallenge[]          @relation("PickupChallengeConsumer")
  handoverTravelEvents                  BookingHandoverTravelEvent[]               @relation("HandoverTravelActor")
  handoverEvidenceWaivers               BookingHandoverEvidenceWaiver[]
  handoverReturnReceipts                BookingHandoverReturnReceipt[]
  pickupHandoverReports                 BookingPickupHandoverReport[]              @relation("PickupHandoverReporter")
  pickupHandoverResponses               BookingPickupHandoverResponse[]            @relation("PickupHandoverResponder")
  overdueHandoverRecoveriesReported     BookingOverdueHandoverRecovery[]           @relation("OverdueHandoverRecoveryReporter")
  overdueHandoverRecoveryResponses      BookingOverdueHandoverRecoveryResponse[]   @relation("OverdueHandoverRecoveryResponder")
  overdueHandoverRecoveryReminders      BookingOverdueHandoverRecoveryReminder[]
  inspectionAmendments                  InspectionAmendment[]                      @relation("InspectionAmendmentCreator")
  inspectionAmendmentReviews            InspectionAmendment[]                      @relation("InspectionAmendmentReviewer")
  inspectionConditionIssues             InspectionConditionIssue[]                 @relation("InspectionConditionIssueCreator")
  vehicleKnownIssuesCreated             VehicleKnownIssue[]                        @relation("VehicleKnownIssueCreator")
  vehicleKnownIssuesResolved            VehicleKnownIssue[]                        @relation("VehicleKnownIssueResolver")
  vehicleKnownIssueEvidence             VehicleKnownIssueEvidence[]                @relation("VehicleKnownIssueEvidenceUploader")
  pickupDiscrepancyResponses            PickupDiscrepancyResponse[]                @relation("PickupDiscrepancyResponder")
  pickupResolutionReviews               PickupDiscrepancyResolutionReview[]        @relation("PickupDiscrepancyReviewer")
  pickupOperationsResolutions           PickupHandoverOperationsResolution[]       @relation("PickupHandoverOperationsResolver")
  postReturnClaims                      PostReturnClaim[]                          @relation("PostReturnClaimSubmitter")
  claimLateOverrides                    PostReturnClaim[]                          @relation("ClaimLateOverride")
  claimEvidenceSubmitted                PostReturnClaimEvidence[]                  @relation("ClaimEvidenceSubmitter")
  claimResponses                        ClaimResponse[]                            @relation("ClaimResponseRenter")
  claimAdjudications                    ClaimAdjudication[]                        @relation("ClaimAdjudicator")
  disputesOpened                        Dispute[]                                  @relation("DisputeOpener")
  disputesResolved                      Dispute[]                                  @relation("DisputeResolver")
  disputeEvidenceSubmitted              DisputeEvidence[]                          @relation("DisputeEvidenceSubmitter")
  earningHoldsCreated                   EarningHold[]                              @relation("EarningHoldCreator")
  earningHoldsReleased                  EarningHold[]                              @relation("EarningHoldReleaser")
  rentalIncidents                       RentalIncident[]                           @relation("RentalIncidentReporter")
  payoutAccountsCreated                 OwnerPayoutAccount[]                       @relation("PayoutAccountCreator")
  payoutEligibilitiesSet                PayoutEligibility[]                        @relation("PayoutEligibilityActor")
  payoutBatchesCreated                  PayoutBatch[]                              @relation("PayoutBatchCreator")
  payoutsCreated                        Payout[]                                   @relation("PayoutCreator")
  payoutsApproved                       Payout[]                                   @relation("PayoutApprover")
  payoutOperations                      PayoutOperation[]                          @relation("PayoutOperationActor")
  ownerObligationWaivers                OwnerObligationWaiver[]                    @relation("OwnerObligationWaiverAdmin")
  conversationParticipants              ConversationParticipant[]
  sentMessages                          Message[]                                  @relation("MessageSender")
  notifications                         Notification[]
  notificationPreferences               NotificationPreference[]
  devicePushTokens                      DevicePushToken[]
  authoredReviews                       Review[]                                   @relation("ReviewAuthor")
  subjectReviews                        Review[]                                   @relation("ReviewSubjectUser")
  supportTicketsCreated                 SupportTicket[]                            @relation("SupportTicketCreator")
  supportTicketsAssigned                SupportTicket[]                            @relation("SupportTicketAssignee")
  supportMessages                       SupportTicketMessage[]
  bookingAmendmentsRequested            BookingAmendment[]                         @relation("BookingAmendmentRequester")
  bookingAmendmentHistoryActions        BookingAmendmentStatusHistory[]            @relation("BookingAmendmentHistoryActor")
  bookingAmendmentRefundEvidenceActions BookingAmendmentRefundResolutionEvidence[] @relation("BookingAmendmentRefundEvidenceActor")
  moderationReportsCreated              ModerationReport[]                         @relation("ModerationReporter")
  moderationReportsAgainst              ModerationReport[]                         @relation("ModerationReportedUser")
  moderationReportsResolved             ModerationReport[]                         @relation("ModerationResolver")
  adminIdentity                         AdminUser?                                 @relation("AdminCredential")

  @@index([status])
  @@map("users")
}

