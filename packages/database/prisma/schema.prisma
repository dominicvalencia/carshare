  dispute      Dispute?         @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  incident     RentalIncident?  @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("EarningHoldCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  releasedBy   User?            @relation("EarningHoldReleaser", fields: [releasedByUserId], references: [id], onDelete: Restrict)

  @@index([ownerEarningId, status, createdAt])
  @@index([claimId, status])
  @@map("earning_holds")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  operationId      String?      @unique @map("operation_id") @db.Uuid
  amountMinor      BigInt       @map("amount_minor")
  currency         String       @db.Char(3)
  status           RefundStatus @default(REQUESTED)
  reason           String       @db.VarChar(1000)
  externalRefundId String?      @map("external_refund_id") @db.VarChar(255)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)

  payment                Payment                        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  operation              PaymentOperation?              @relation(fields: [operationId], references: [id], onDelete: Restrict)
  disputes               Dispute[]
  cancellationSettlement BookingCancellationSettlement?
  amendmentSettlement    BookingAmendmentSettlement?    @relation("BookingAmendmentSettlementRefund")

  @@index([paymentId, status])
  @@map("refunds")
}

model SecurityDepositAuthorization {
  id                    String                @id @default(uuid()) @db.Uuid
  bookingId             String                @unique @map("booking_id") @db.Uuid
  paymentId             String?               @unique @map("payment_id") @db.Uuid
  status                SecurityDepositStatus @default(NOT_REQUIRED)
  requiredAmountMinor   BigInt                @default(0) @map("required_amount_minor")
  authorizedAmountMinor BigInt                @default(0) @map("authorized_amount_minor")
  usedAmountMinor       BigInt                @default(0) @map("used_amount_minor")
  currency              String                @default("PHP") @db.Char(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("security_deposit_authorizations")
}

model PayoutEligibility {
  id              String                  @id @default(uuid()) @db.Uuid
  ownerProfileId  String                  @unique @map("owner_profile_id") @db.Uuid
  status          PayoutEligibilityStatus @default(NOT_READY)
  reason          String?                 @db.VarChar(1000)
  requirements    Json?
  lastEvaluatedAt DateTime?               @map("last_evaluated_at") @db.Timestamptz(3)
  changedByUserId String?                 @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerProfile OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)
  changedBy    User?        @relation("PayoutEligibilityActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
  @@map("payout_eligibilities")
}

model OwnerPayoutAccount {
  id                         String                @id @default(uuid()) @db.Uuid
  ownerProfileId             String                @map("owner_profile_id") @db.Uuid
  type                       PayoutDestinationType
  provider                   PayoutProviderCode
  destinationChannel         String                @map("destination_channel") @db.VarChar(100)
  accountHolderName          String                @map("account_holder_name") @db.VarChar(255)
  maskedAccountIdentifier    String                @map("masked_account_identifier") @db.VarChar(64)
  identifierFingerprint      String                @map("identifier_fingerprint") @db.Char(64)
  encryptedAccountIdentifier String                @map("encrypted_account_identifier") @db.Text
  encryptionIv               String                @map("encryption_iv") @db.VarChar(64)
  encryptionAuthTag          String                @map("encryption_auth_tag") @db.VarChar(64)
  encryptionKeyVersion       Int                   @default(1) @map("encryption_key_version")
  country                    String                @default("PH") @db.Char(2)
  currency                   String                @default("PHP") @db.Char(3)
  status                     PayoutAccountStatus   @default(PENDING_VERIFICATION)
  validationLevel            String?               @map("validation_level") @db.VarChar(100)
  safeValidationReference    String?               @map("safe_validation_reference") @db.VarChar(255)
  isDefault                  Boolean               @default(false) @map("is_default")
  verifiedAt                 DateTime?             @map("verified_at") @db.Timestamptz(3)
  disabledAt                 DateTime?             @map("disabled_at") @db.Timestamptz(3)
  createdByUserId            String                @map("created_by_user_id") @db.Uuid
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerProfile OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("PayoutAccountCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  payouts      Payout[]

  @@unique([ownerProfileId, provider, destinationChannel, identifierFingerprint])
  @@index([ownerProfileId, status, createdAt])
  @@map("owner_payout_accounts")
}

model PayoutBatch {
  id              String            @id @default(uuid()) @db.Uuid
  publicReference String            @unique @map("public_reference") @db.VarChar(32)
  status          PayoutBatchStatus @default(DRAFT)
  currency        String            @default("PHP") @db.Char(3)
  note            String?           @db.VarChar(1000)
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User     @relation("PayoutBatchCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  payouts   Payout[]

  @@index([status, createdAt])
  @@map("payout_batches")
}

model Payout {
  id                       String                 @id @default(uuid()) @db.Uuid
  publicReference          String                 @unique @map("public_reference") @db.VarChar(32)
  batchId                  String                 @map("batch_id") @db.Uuid
  ownerProfileId           String                 @map("owner_profile_id") @db.Uuid
  payoutAccountId          String                 @map("payout_account_id") @db.Uuid
  provider                 PayoutProviderCode
  status                   PayoutStatus           @default(DRAFT)
  amountMinor              BigInt                 @map("amount_minor")
  grossEarningMinor        BigInt                 @map("gross_earning_minor")
  adjustmentAmountMinor    BigInt                 @default(0) @map("adjustment_amount_minor")
  withholdingAmountMinor   BigInt                 @default(0) @map("withholding_amount_minor")
  providerFeeAmountMinor   BigInt                 @default(0) @map("provider_fee_amount_minor")
  feePolicy                PayoutFeePolicy        @default(PLATFORM_FUNDED) @map("fee_policy")
  currency                 String                 @default("PHP") @db.Char(3)
  destinationType          PayoutDestinationType  @map("destination_type")
  destinationChannel       String                 @map("destination_channel") @db.VarChar(100)
  destinationMasked        String                 @map("destination_masked") @db.VarChar(64)
  destinationAccountHolder String                 @map("destination_account_holder") @db.VarChar(255)
  destinationCountry       String                 @default("PH") @map("destination_country") @db.Char(2)
  destinationCurrency      String                 @default("PHP") @map("destination_currency") @db.Char(3)
  providerPayoutId         String?                @map("provider_payout_id") @db.VarChar(255)
  providerState            String?                @map("provider_state") @db.VarChar(100)
  failureCategory          PayoutFailureCategory? @map("failure_category")
  safeFailureCode          String?                @map("safe_failure_code") @db.VarChar(100)
  safeFailureMessage       String?                @map("safe_failure_message") @db.VarChar(500)
  reconciliationRequired   Boolean                @default(false) @map("reconciliation_required")
  reconcileAfter           DateTime?              @map("reconcile_after") @db.Timestamptz(3)
  lastProviderRetrievedAt  DateTime?              @map("last_provider_retrieved_at") @db.Timestamptz(3)
  approvedAt               DateTime?              @map("approved_at") @db.Timestamptz(3)
  submittedAt              DateTime?              @map("submitted_at") @db.Timestamptz(3)
  paidAt                   DateTime?              @map("paid_at") @db.Timestamptz(3)
  failedAt                 DateTime?              @map("failed_at") @db.Timestamptz(3)
  cancelledAt              DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  reversedAt               DateTime?              @map("reversed_at") @db.Timestamptz(3)
  createdByUserId          String                 @map("created_by_user_id") @db.Uuid
  approvedByUserId         String?                @map("approved_by_user_id") @db.Uuid
  approvalNote             String?                @map("approval_note") @db.VarChar(1000)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch                PayoutBatch               @relation(fields: [batchId], references: [id], onDelete: Restrict)
  ownerProfile         OwnerProfile              @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)
  payoutAccount        OwnerPayoutAccount        @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  createdBy            User                      @relation("PayoutCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy           User?                     @relation("PayoutApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  items                PayoutItem[]
  operations           PayoutOperation[]
  webhookEvents        PayoutWebhookEvent[]
  obligationRecoveries OwnerObligationRecovery[]
  adjustments          PayoutAdjustment[]

  @@unique([provider, providerPayoutId])
  @@index([ownerProfileId, status, createdAt])
  @@index([status, reconciliationRequired, reconcileAfter])
  @@index([batchId, status])
  @@map("payouts")
}

model PayoutItem {
  id               String    @id @default(uuid()) @db.Uuid
  payoutId         String    @map("payout_id") @db.Uuid
  ownerEarningId   String    @map("owner_earning_id") @db.Uuid
  amountMinor      BigInt    @map("amount_minor")
  currency         String    @default("PHP") @db.Char(3)
  activeAllocation Boolean   @default(true) @map("active_allocation")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt       DateTime? @map("released_at") @db.Timestamptz(3)

  payout               Payout                    @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  ownerEarning         OwnerEarning              @relation(fields: [ownerEarningId], references: [id], onDelete: Restrict)
  obligationRecoveries OwnerObligationRecovery[]

  @@unique([payoutId, ownerEarningId])
  @@index([ownerEarningId, activeAllocation])
  @@map("payout_items")
}

model PayoutAdjustment {
  id                  String                 @id @default(uuid()) @db.Uuid
  payoutId            String                 @map("payout_id") @db.Uuid
  type                PayoutAdjustmentType
  status              PayoutAdjustmentStatus @default(RESERVED)
  signedAmountMinor   BigInt                 @map("signed_amount_minor")
  currency            String                 @db.Char(3)
  sourceType          String                 @map("source_type") @db.VarChar(100)
  sourceId            String                 @map("source_id") @db.Uuid
  idempotencyKey      String                 @unique @map("idempotency_key") @db.VarChar(200)
  ledgerTransactionId String?                @unique @map("ledger_transaction_id") @db.Uuid
  correlationId       String?                @map("correlation_id") @db.VarChar(100)
  auditMetadata       Json?                  @map("audit_metadata")
  appliedAt           DateTime?              @map("applied_at") @db.Timestamptz(3)
  releasedAt          DateTime?              @map("released_at") @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  payout            Payout             @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@unique([payoutId, type, sourceType, sourceId])
  @@index([payoutId, status, createdAt])
  @@index([sourceType, sourceId, status])
  @@map("payout_adjustments")
}

model OwnerFinancialObligation {
  id                       String                         @id @default(uuid()) @db.Uuid
  ownerProfileId           String                         @map("owner_profile_id") @db.Uuid
  sourceCancellationId     String                         @map("source_cancellation_id") @db.Uuid
  cancellationSettlementId String                         @map("cancellation_settlement_id") @db.Uuid
  commissionSnapshotId     String                         @map("commission_snapshot_id") @db.Uuid
  type                     OwnerFinancialObligationType
  status                   OwnerFinancialObligationStatus @default(OUTSTANDING)
  originalAmountMinor      BigInt                         @map("original_amount_minor")
  remainingAmountMinor     BigInt                         @map("remaining_amount_minor")
  recoveredAmountMinor     BigInt                         @default(0) @map("recovered_amount_minor")
  waivedAmountMinor        BigInt                         @default(0) @map("waived_amount_minor")
  currency                 String                         @db.Char(3)
  policyVersion            String                         @map("policy_version") @db.VarChar(100)
  reasonCode               CancellationReasonCode         @map("reason_code")
  effectiveAt              DateTime                       @map("effective_at") @db.Timestamptz(3)
  correlationId            String?                        @map("correlation_id") @db.VarChar(100)
  auditMetadata            Json?                          @map("audit_metadata")
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerProfile           OwnerProfile                  @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)
  sourceCancellation     BookingCancellation           @relation(fields: [sourceCancellationId], references: [id], onDelete: Restrict)
  cancellationSettlement BookingCancellationSettlement @relation(fields: [cancellationSettlementId], references: [id], onDelete: Restrict)
  commissionSnapshot     CommissionSnapshot            @relation(fields: [commissionSnapshotId], references: [id], onDelete: Restrict)
  recoveries             OwnerObligationRecovery[]
  waivers                OwnerObligationWaiver[]

  @@unique([sourceCancellationId, type])
  @@index([ownerProfileId, status, effectiveAt, id])
  @@map("owner_financial_obligations")
}

model OwnerObligationRecovery {
  id                  String   @id @default(uuid()) @db.Uuid
  obligationId        String   @map("obligation_id") @db.Uuid
  payoutId            String   @map("payout_id") @db.Uuid
  payoutItemId        String?  @map("payout_item_id") @db.Uuid
  ownerEarningId      String?  @map("owner_earning_id") @db.Uuid
  ledgerTransactionId String   @unique @map("ledger_transaction_id") @db.Uuid
  amountMinor         BigInt   @map("amount_minor")
  currency            String   @db.Char(3)
  idempotencyKey      String   @unique @map("idempotency_key") @db.VarChar(200)
  recoveredAt         DateTime @default(now()) @map("recovered_at") @db.Timestamptz(3)

  obligation        OwnerFinancialObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  payout            Payout                   @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  payoutItem        PayoutItem?              @relation(fields: [payoutItemId], references: [id], onDelete: Restrict)
  ownerEarning      OwnerEarning?            @relation(fields: [ownerEarningId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction        @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@index([obligationId, recoveredAt, id])
  @@index([payoutId, recoveredAt])
  @@map("owner_obligation_recoveries")
}

model OwnerObligationWaiver {
  id                  String                      @id @default(uuid()) @db.Uuid
  obligationId        String                      @map("obligation_id") @db.Uuid
  amountMinor         BigInt                      @map("amount_minor")
  currency            String                      @db.Char(3)
  adminActorUserId    String                      @map("admin_actor_user_id") @db.Uuid
  reasonCode          OwnerObligationWaiverReason @map("reason_code")
  internalDetail      String?                     @map("internal_detail") @db.VarChar(2000)
  evidenceReference   String?                     @map("evidence_reference") @db.VarChar(255)
  correlationId       String?                     @map("correlation_id") @db.VarChar(100)
  auditMetadata       Json?                       @map("audit_metadata")
  idempotencyKey      String                      @unique @map("idempotency_key") @db.VarChar(200)
  ledgerTransactionId String                      @unique @map("ledger_transaction_id") @db.Uuid
  waivedAt            DateTime                    @default(now()) @map("waived_at") @db.Timestamptz(3)

  obligation        OwnerFinancialObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  adminActor        User                     @relation("OwnerObligationWaiverAdmin", fields: [adminActorUserId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction        @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@index([obligationId, waivedAt, id])
  @@map("owner_obligation_waivers")
}

model PayoutOperation {
  id                         String                 @id @default(uuid()) @db.Uuid
  payoutId                   String                 @map("payout_id") @db.Uuid
  type                       PayoutOperationType
  status                     PayoutOperationStatus  @default(PENDING)
  idempotencyKey             String                 @unique @map("idempotency_key") @db.VarChar(200)
  providerRequestReference   String?                @map("provider_request_reference") @db.VarChar(100)
  providerOperationReference String?                @map("provider_operation_reference") @db.VarChar(255)
  attemptCount               Int                    @default(0) @map("attempt_count")
  failureCategory            PayoutFailureCategory? @map("failure_category")
  safeFailureCode            String?                @map("safe_failure_code") @db.VarChar(100)
  safeFailureMessage         String?                @map("safe_failure_message") @db.VarChar(500)
  safeProviderMetadata       Json?                  @map("safe_provider_metadata")
  actorUserId                String?                @map("actor_user_id") @db.Uuid
  correlationId              String?                @map("correlation_id") @db.VarChar(100)
  startedAt                  DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt                DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  actor  User?  @relation("PayoutOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([payoutId, createdAt])
  @@index([status, createdAt])
  @@map("payout_operations")
}

model PayoutWebhookEvent {
  id               String              @id @default(uuid()) @db.Uuid
  payoutId         String?             @map("payout_id") @db.Uuid
  provider         PayoutProviderCode
  externalEventId  String              @map("external_event_id") @db.Char(64)
  eventType        String              @map("event_type") @db.VarChar(100)
  providerPayoutId String              @map("provider_payout_id") @db.VarChar(255)
  status           PayoutWebhookStatus @default(RECEIVED)
  payloadDigest    String              @map("payload_digest") @db.Char(64)
  redactedPayload  Json?               @map("redacted_payload")
  attemptCount     Int                 @default(0) @map("attempt_count")
  failureReason    String?             @map("failure_reason") @db.VarChar(500)
  receivedAt       DateTime            @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt      DateTime?           @map("processed_at") @db.Timestamptz(3)

  payout Payout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@index([provider, providerPayoutId])
  @@map("payout_webhook_events")
}
