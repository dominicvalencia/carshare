NODE_ENV=development
APP_ENV=local
RELEASE_VERSION=development
SERVICE_NAME=carshare-api
DATABASE_ENVIRONMENT=local
REDIS_ENVIRONMENT=local

API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_ENV=local
NEXT_PUBLIC_RELEASE_VERSION=development
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_ENV=local
EXPO_PUBLIC_RELEASE_VERSION=development
# Domain-ready placeholders. Leave unset until a domain is owned and approved.
# PUBLIC_DOMAIN=
# STAGING_API_ORIGIN=
# STAGING_ADMIN_ORIGIN=
# STAGING_LINKS_ORIGIN=

POSTGRES_DB=carrental
POSTGRES_USER=carrental
POSTGRES_PASSWORD=carrental_local_only
DATABASE_URL=postgresql://carrental:carrental_local_only@localhost:5432/carrental?schema=public
# Integration fixtures use a separate PostgreSQL database and never appear in the development app.
TEST_DATABASE_URL=postgresql://carrental:carrental_local_only@localhost:5432/carrental_test?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=local-access-secret-change-before-any-shared-deployment
TOKEN_HASH_SECRET=local-token-hash-secret-change-before-any-shared-deployment
JWT_ISSUER=carrental-api
JWT_AUDIENCE=carrental-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
QUOTE_TTL_MINUTES=15
BOOKING_HOLD_TTL_MINUTES=10
OWNER_RESPONSE_TTL_MINUTES=60
PICKUP_WINDOW_EARLY_MINUTES=30
PICKUP_WINDOW_GRACE_MINUTES=60
RETURN_CONFIRMATION_GRACE_MINUTES=120
PICKUP_VERIFICATION_TTL_MINUTES=10
PICKUP_VERIFICATION_MAX_ATTEMPTS=5
RENTAL_OPERATIONS_SWEEP_SECONDS=15
CLAIM_RESPONSE_WINDOW_HOURS=24
POST_RENTAL_MESSAGING_DAYS=30
REVIEW_WINDOW_DAYS=14
MESSAGE_MAX_LENGTH=2000
MESSAGE_RATE_LIMIT_PER_MINUTE=20
PUSH_PROVIDER=fake
PUSH_ENABLED=false
NOTIFICATION_DELIVERY_INTERVAL_SECONDS=10
PUSH_RECEIPT_DELAY_SECONDS=900
# Optional for an Expo project configured with push access-token security.
# EXPO_PUSH_ACCESS_TOKEN=
# Firebase/FCM project metadata is preparation-only until a controlled credential is supplied.
# FIREBASE_PROJECT_ID=
# FIREBASE_ANDROID_APP_ID=
# FCM_CREDENTIALS_BASE64=
# Used by the mobile client when requesting an Expo push token.
# EXPO_PUBLIC_PROJECT_ID=
# Required outside local when an EAS project ID is configured; must match EXPO_PUBLIC_APP_ENV.
# EXPO_PUBLIC_PROJECT_ENV=local
# Native Android Firebase client config. Keep the JSON under ignored .data/.
# EXPO_ANDROID_GOOGLE_SERVICES_FILE=.data/firebase/local/google-services.json
# EXPO_ANDROID_FIREBASE_ENV=local
PUSH_CERTIFICATION_ENABLED=false
# PUSH_CERTIFICATION_EXPO_TOKEN=
PAYMENT_PROVIDER=fake
PAYMENTS_ENABLED=false
PAYMENT_UNKNOWN_GRACE_MINUTES=5
PAYMENT_RECONCILE_INTERVAL_SECONDS=15
PAYOUT_PROVIDER=fake
PAYOUTS_ENABLED=false
PAYOUT_MINIMUM_AMOUNT_MINOR=10000
PAYOUT_AUTO_CREATE=false
PAYOUT_AUTO_SUBMIT=false
PAYOUT_RECONCILE_INTERVAL_SECONDS=30
PAYOUT_SUBMITTING_STALE_SECONDS=60
PAYOUT_PROCESSING_STALE_SECONDS=300
PAYOUT_FOUR_EYES_ENABLED=false
PAYOUT_WITHHOLDING_ENABLED=false
PAYOUT_DATA_ENCRYPTION_KEY_BASE64=bG9jYWwtcGF5b3V0LWVuY3J5cHRpb24ta2V5LTMyISE=
PAYOUT_IDENTIFIER_HASH_SECRET=local-payout-identifier-hash-secret-change-me
XENDIT_ENVIRONMENT=test
XENDIT_CERTIFICATION_ENABLED=false
# Required when PAYOUT_PROVIDER=xendit. Use a MONEY-OUT enabled server-side key.
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
SECURITY_DEPOSIT_ENABLED=false
MAYA_ENVIRONMENT=sandbox
MAYA_AUTH_CAPTURE_ENABLED=false
MAYA_VOID_REFUND_ENABLED=false
MAYA_SUCCESS_URL=http://localhost:8081/payment/success
MAYA_FAILURE_URL=http://localhost:8081/payment/failure
MAYA_CANCEL_URL=http://localhost:8081/payment/cancel
MAYA_CERTIFICATION_ENABLED=false
# Required when PAYMENT_PROVIDER=maya. Obtain merchant feature enablement before use.
# MAYA_PUBLIC_KEY=
# MAYA_SECRET_KEY=
AUTH_DELIVERY_PROVIDER=development
AUTH_DELIVERY_ENABLED=false
EMAIL_ENABLED=false
SMS_OTP_ENABLED=false
AUTOMATED_KYC_ENABLED=false
EMAIL_PROVIDER=disabled
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound
# POSTMARK_WEBHOOK_SECRET=
POSTMARK_CERTIFICATION_ENABLED=false
# POSTMARK_CERTIFICATION_RECIPIENT=
SMS_PROVIDER=disabled
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=
SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages
SEMAPHORE_CERTIFICATION_ENABLED=false
# SEMAPHORE_CERTIFICATION_RECIPIENT=
KYC_PROVIDER=manual
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
GEOCODING_PROVIDER=disabled
OBSERVABILITY_ENABLED=false
SENTRY_ENABLED=false
# Each service maps to its own Sentry project. Keep values empty/ignored locally.
# SENTRY_API_DSN=
# SENTRY_WORKERS_DSN=
# EXPO_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
# One-event certification switches are local/test-only; normally keep false.
SENTRY_TEST_EVENT_ENABLED=false
EXPO_PUBLIC_SENTRY_TEST_EVENT_ENABLED=false
NEXT_PUBLIC_SENTRY_TEST_EVENT_ENABLED=false
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_ENVIRONMENT=local
OBJECT_STORAGE_ROOT=.data/objects
ADMIN_REFRESH_COOKIE_NAME=carrental_admin_refresh
COOKIE_SECURE=false

# Optional one-time local bootstrap. Never commit real credentials.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters
# Set false when you want only reference/configuration data.
SEED_DEMO_DATA=true

LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
